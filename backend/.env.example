# =============================================================================
# Chhath Radio — Backend Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git.
# In production, all values are set via GitHub Actions secrets → Render env vars.
# Run scripts/deploy-setup.sh to configure everything automatically.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# REQUIRED — must be at least 32 characters. No default in production.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Local dev (Docker):
#   DATABASE_URL=postgresql://chhath:chhath_secret@localhost:5432/chhath_radio
#
# Production (Supabase — free tier, 500MB):
#   1. Go to https://supabase.com → New Project
#   2. Project Settings → Database → Connection Pooling → copy URI (port 6543)
#   Format: postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://chhath:chhath_secret@localhost:5432/chhath_radio

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev (Docker):
#   REDIS_URL=redis://localhost:6379/0
#
# Production (Upstash — free tier, 10k commands/day):
#   1. Go to https://upstash.com → Create Database → Redis
#   2. Choose region: ap-south-1 (Mumbai) for low latency
#   3. Database → Details → copy UPSTASH_REDIS_URL
#   Format: rediss://default:[token]@[host].upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ── Admin Account ─────────────────────────────────────────────────────────────
# Used by run_server.sh to auto-seed the admin user on first startup.
# seed_admin.py is idempotent — safe to run on every deploy.
# REQUIRED — both vars must be set. No defaults.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed origins for the FastAPI backend.
# Local dev: "*" (allow all)
# Production: set to your Vercel URL (comma-separated for multiple)
#   CORS_ORIGINS=https://chhathradio.vercel.app,https://chhathradio.com
CORS_ORIGINS=*

# ── Web Push Notifications (VAPID) ───────────────────────────────────────────
# Generate a key pair with: npx web-push generate-vapid-keys
# Or use: https://vapidkeys.com
# NEXT_PUBLIC_VAPID_PUBLIC_KEY (the public key) also goes in frontend/.env.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chhathradio.com

# ── Server ────────────────────────────────────────────────────────────────────
# Number of Gunicorn workers. Default: 1 for Render free tier (512MB RAM).
# Increase for paid plans: 2*CPU+1 is a good rule of thumb.
WEB_CONCURRENCY=1

# Uvicorn log level: debug | info | warning | error | critical
LOG_LEVEL=info