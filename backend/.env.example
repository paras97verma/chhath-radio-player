# Copy this file to .env and fill in your values
# cp .env.example .env

# Application
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED — must be at least 32 characters. No default in production.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DEBUG=false

# Calendarific API key (free tier — 500 req/month) for Chhath Puja dates
# Get yours at https://calendarific.com/
CALENDARIFIC_API_KEY=your-calendarific-api-key-here

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://chhath:chhath@localhost:5432/chhath_radio

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379/0

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin seeding (REQUIRED on first run — both vars must be set, no defaults)
# Run: ADMIN_EMAIL=admin@example.com ADMIN_PASSWORD=mysecret python seed_admin.py
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS — allowed origins for the FastAPI backend.
# Use "*" to allow all origins (default; good for local dev and ngrok tunnels).
# For production, set a comma-separated list of exact origins:
#   CORS_ORIGINS=https://chhathradio.com,https://www.chhathradio.com
CORS_ORIGINS=*

# Push Notifications (VAPID keys for Web Push API)
# Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY goes in frontend/.env.local
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@chhathradio.com